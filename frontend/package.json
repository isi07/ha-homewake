{
  "name": "homewake-card",
  "private": true,
  "description": "Dashboard-Karte von HomeWake (ARCHITEKTUR.md 5.6, E59, E62, E66-E73)",
  "type": "module",
  "scripts": {
    "build": "esbuild src/homewake-card.ts --bundle --minify --format=esm --target=es2022 --legal-comments=none --outfile=../custom_components/homewake/frontend/homewake-card.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run types && npm run test"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@vitest/coverage-v8": "5.1.2",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
